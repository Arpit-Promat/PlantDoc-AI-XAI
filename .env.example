# Database
DATABASE_URL=
# Production example: postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Security: minimum 32 characters; use a cryptographically random value in production.
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters

# Cookies / HTTPS
COOKIE_SECURE=0
FORCE_HTTPS=0

# Optional host allowlist, comma-separated.
TRUSTED_HOSTS=

# Upload/request limits
MAX_CONTENT_LENGTH=10485760
MAX_FORM_MEMORY_SIZE=500000

# Rate-limit storage. memory:// is for local development; use Redis in production.
RATELIMIT_STORAGE_URI=memory://

# Runtime
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
PORT=5000
