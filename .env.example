# Database
# Leave unset for local SQLite. For production use PostgreSQL, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Security: use a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Cookies / HTTPS
COOKIE_SECURE=0
FORCE_HTTPS=0

# Optional host allowlist, comma-separated (for example: example.com,www.example.com)
TRUSTED_HOSTS=

# Optional request limits (bytes)
MAX_CONTENT_LENGTH=10485760
MAX_FORM_MEMORY_SIZE=500000

# Runtime
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
PORT=5000
